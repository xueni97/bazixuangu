# 渊海子平八字选股 环境配置示例
# 复制为 .env 并按实际填写，.env 已在 .gitignore 中不会提交

# ── 后端 Flask / SQLite ──────────────────────────────
# SQLite 数据库路径（默认 项目根/data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# Flask 监听地址：本地开发 127.0.0.1，服务器部署 0.0.0.0
FLASK_HOST=0.0.0.0
# Flask 监听端口（本地开发 5175，服务器 5000）
FLASK_PORT=5000
# Flask 调试模式：本地 dev=1，服务器 prod=0
FLASK_DEBUG=0

# ── 前端构建（vite） ────────────────────────────────
# 服务器部署时填写：浏览器访问服务器 Web 版时回测直连此 base 调 /api/klines
# 留空 = APP/本地开发模式（IndexedDB + 网络兜底链）
# 示例：http://your.server.ip:5000  或  https://bazi.yourdomain.com
VITE_API_BASE=

# ── gunicorn（仅服务器 systemd 用） ──────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ── 数据同步 ────────────────────────────────────────
# 同步并发数（学生服务器建议 2-4，过高触发数据源 IP 限流）
SYNC_WORKERS=4
# cron 触发时间（仅供文档参考，实际在 crontab 配置）
SYNC_CRON="5 16 * * 1-5"
